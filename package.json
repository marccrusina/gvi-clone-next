{
  "name": "gvi-clone-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "biome check ./ && tsc --noEmit && next build --turbopack",
    "start": "next start",
    "lint": "biome check --write ./",
    "format": "biome format --write ./",
    "biome-check": "biome check ./",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@glidejs/glide": "^3.7.1",
    "@tanstack/react-query": "^5.87.4",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "next": "15.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sass": "^1.93.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@tanstack/react-query-devtools": "^5.87.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/axios": "^0.9.36",
    "@types/glidejs__glide": "^3.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.2.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
